{
  "name": "ci-cd",
  "version": "1.0.0",
  "description": "Sandbox for CI/CD Frameworks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mechanicode-io/ci-cd.git"
  },
  "keywords": [
    "ci-cd",
    "fastapi",
    "docker",
    "semantic-release",
    "conventional-commits"
  ],
  "license": "BUSL-3",
  "bugs": {
    "url": "https://github.com/mechanicode-io/ci-cd/issues"
  },
  "homepage": "https://github.com/mechanicode-io/ci-cd#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "semantic-release": "^25.0.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "sed -i 's/^version:.*/version: ${nextRelease.version}/' Chart.yaml"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "Chart.yaml",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}\n\n[skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
